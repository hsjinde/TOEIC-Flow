{
  "grammar/04_特殊動詞用法/01_使役動詞": {
    "chapterId": "grammar/04_特殊動詞用法/01_使役動詞",
    "title": "使役動詞用法決策樹",
    "titleEn": "Decision Tree: Causative Verb Usage",
    "decision": {
      "question": "O 與 V 的關係",
      "questionEn": "Relationship Between Object & Verb",
      "branches": [
        {
          "label": "主動：受詞執行動作",
          "labelEn": "Active: O Performs Action"
        },
        {
          "label": "被動：受詞接受動作",
          "labelEn": "Passive: Action Acts Upon O"
        }
      ]
    },
    "table": {
      "title": "使役動詞用法總表",
      "titleEn": "Master Table of Causative Verb Usage",
      "rowHeader": "動詞",
      "rows": [
        {
          "head": "make",
          "gloss": "強迫",
          "cells": [
            [
              {
                "pattern": "make O",
                "token": "RV",
                "example": "make him clean"
              }
            ],
            [
              {
                "pattern": "make O",
                "token": "p.p.",
                "example": "make himself known"
              }
            ]
          ]
        },
        {
          "head": "have",
          "gloss": "指派",
          "cells": [
            [
              {
                "pattern": "have O",
                "token": "RV",
                "example": "have them finish"
              },
              {
                "pattern": "have O",
                "token": "V-ing",
                "example": "had everyone complaining"
              }
            ],
            [
              {
                "pattern": "have O",
                "token": "p.p.",
                "example": "have the report sent"
              }
            ]
          ]
        },
        {
          "head": "get",
          "gloss": "說服",
          "cells": [
            [
              {
                "pattern": "get O",
                "token": "to-RV",
                "example": "get him to go"
              }
            ],
            [
              {
                "pattern": "get O",
                "token": "p.p.",
                "example": "get the work done"
              }
            ]
          ]
        },
        {
          "head": "let",
          "gloss": "允許",
          "cells": [
            [
              {
                "pattern": "let O",
                "token": "RV",
                "example": "let her study"
              }
            ],
            [
              {
                "pattern": "let O",
                "token": "be p.p.",
                "example": "let the light be turned off"
              }
            ]
          ]
        },
        {
          "head": "help",
          "gloss": "協助",
          "cells": [
            [
              {
                "pattern": "help O",
                "token": "(to-)RV",
                "example": ""
              }
            ],
            [
              {
                "pattern": "help O",
                "token": "(to) be p.p.",
                "example": ""
              }
            ]
          ],
          "sharedExample": "help it (to) be understood"
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：被動語態要補回 to",
        "lines": [
          "make / help 改被動 → be made to RV、be helped to RV",
          "have / let 沒有這種被動式，看到 was had to、was let to 直接刪",
          "替代寫法：be required to（代 have）、be allowed to（代 let）"
        ]
      },
      {
        "title": "補充 2：want 與 need",
        "lines": [
          "want / need + to-RV（主動）",
          "事物 + want / need + V-ing ＝ 被動，等於 to be p.p.",
          "The report needs revising = needs to be revised"
        ]
      },
      {
        "title": "補充 3：感官動詞",
        "lines": [
          "see / hear / watch / notice + O + RV（看到全程）",
          "＋ O + V-ing（看到正在進行）",
          "＋ O + p.p.（受詞是被動）"
        ]
      }
    ]
  },
  "grammar/02_動詞時態與語態/09_時態與條件句搭配辨識": {
    "chapterId": "grammar/02_動詞時態與語態/09_時態與條件句搭配辨識",
    "title": "真實條件句時態決策樹",
    "titleEn": "Decision Tree: Real Conditionals",
    "decision": {
      "question": "句子的兩半各用什麼時態",
      "questionEn": "Which Tense Goes in Each Half",
      "branches": [
        {
          "label": "副子句：絕不用 will",
          "labelEn": "Subordinate Clause: Never will"
        },
        {
          "label": "主句：可以用 will",
          "labelEn": "Main Clause: will Allowed"
        }
      ]
    },
    "table": {
      "title": "真實條件句時態總表",
      "titleEn": "Master Table of Real Conditionals",
      "rowHeader": "條件句類型",
      "rows": [
        {
          "head": "零條件",
          "gloss": "恆常事實",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "現在式"
              }
            ],
            [
              {
                "pattern": "S",
                "token": "現在式"
              }
            ]
          ],
          "sharedExample": "If the sensor detects smoke, the alarm sounds."
        },
        {
          "head": "第一類",
          "gloss": "可能發生",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "現在式"
              }
            ],
            [
              {
                "pattern": "S",
                "token": "will + RV"
              }
            ]
          ],
          "sharedExample": "If we approve it today, production will start Monday."
        },
        {
          "head": "祈使句",
          "gloss": "要求動作",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "現在式"
              }
            ],
            [
              {
                "pattern": "V",
                "token": "原形開頭"
              }
            ]
          ],
          "sharedExample": "If you need assistance, contact the front desk."
        },
        {
          "head": "unless",
          "gloss": "除非",
          "cells": [
            [
              {
                "pattern": "Unless S",
                "token": "現在式（肯定）"
              }
            ],
            [
              {
                "pattern": "S",
                "token": "will + RV"
              }
            ]
          ],
          "sharedExample": "Unless the invoice arrives today, we will delay payment."
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：真實還是假設，先看主句",
        "lines": [
          "主句是 will / can / may / must → 真實條件句",
          "主句是 would / could / might → 假設語氣，副子句時態要往後退一格",
          "混搭陷阱：現在式副子句 + would 主句、過去式副子句 + will 主句，兩種都錯"
        ]
      },
      {
        "title": "補充 2：if 的同義連接詞",
        "lines": [
          "provided (that) / providing / on condition that / so long as ＝ if，語氣更正式，時態規則完全相同",
          "unless ＝ if...not，本身已含否定，子句裡不可再加 not",
          "in case 不是 if：語意是「以防萬一」，強調預先防範而非條件成立"
        ]
      },
      {
        "title": "補充 3：只有 only if 要倒裝",
        "lines": [
          "Only if 放句首 → 主句助動詞提前（Only if the budget is approved will the team expand.）",
          "only if 出現在句中則不倒裝",
          "政策類篇章常搭 eligible / entitled / applicable / valid，描述符合條件才享有的權利"
        ]
      }
    ]
  },
  "grammar/03_動狀詞_非謂語動詞/08_不定詞動名詞意義差異動詞": {
    "chapterId": "grammar/03_動狀詞_非謂語動詞/08_不定詞動名詞意義差異動詞",
    "title": "to V 與 V-ing 語意差異決策樹",
    "titleEn": "Decision Tree: Infinitive vs. Gerund",
    "decision": {
      "question": "語意指向未來還是已發生",
      "questionEn": "Does the Meaning Point Forward or Back",
      "branches": [
        {
          "label": "to V：還沒做、要去做",
          "labelEn": "to V: Not Yet Done"
        },
        {
          "label": "V-ing：已做過、進行中",
          "labelEn": "V-ing: Already Done or Ongoing"
        }
      ]
    },
    "table": {
      "title": "語意差異動詞總表",
      "titleEn": "Master Table of Meaning-Shift Verbs",
      "rowHeader": "動詞",
      "rows": [
        {
          "head": "remember",
          "gloss": "記得",
          "cells": [
            [
              {
                "pattern": "remember",
                "token": "to V",
                "example": "remember to lock the lab"
              }
            ],
            [
              {
                "pattern": "remember",
                "token": "V-ing",
                "example": "remember locking the lab"
              }
            ]
          ]
        },
        {
          "head": "forget",
          "gloss": "忘記",
          "cells": [
            [
              {
                "pattern": "forget",
                "token": "to V",
                "example": "forget to submit the form"
              }
            ],
            [
              {
                "pattern": "forget",
                "token": "V-ing",
                "example": "forget submitting the form"
              }
            ]
          ]
        },
        {
          "head": "stop",
          "gloss": "停止",
          "cells": [
            [
              {
                "pattern": "stop",
                "token": "to V",
                "example": "stop to take a call"
              }
            ],
            [
              {
                "pattern": "stop",
                "token": "V-ing",
                "example": "stop taking calls"
              }
            ]
          ]
        },
        {
          "head": "try",
          "gloss": "嘗試",
          "cells": [
            [
              {
                "pattern": "try",
                "token": "to V",
                "example": "try to meet the deadline"
              }
            ],
            [
              {
                "pattern": "try",
                "token": "V-ing",
                "example": "try restarting the router"
              }
            ]
          ]
        },
        {
          "head": "go on",
          "gloss": "繼續",
          "cells": [
            [
              {
                "pattern": "go on",
                "token": "to V",
                "example": "go on to discuss the budget"
              }
            ],
            [
              {
                "pattern": "go on",
                "token": "V-ing",
                "example": "go on working overtime"
              }
            ]
          ]
        },
        {
          "head": "regret",
          "gloss": "遺憾",
          "cells": [
            [
              {
                "pattern": "regret",
                "token": "to V",
                "example": "regret to inform you"
              }
            ],
            [
              {
                "pattern": "regret",
                "token": "V-ing",
                "example": "regret sending the email"
              }
            ]
          ]
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：只接 V-ing，不必判斷語意",
        "lines": [
          "quit、finish、avoid、mind、enjoy 一律接 V-ing",
          "can't help + V-ing，但 can't help but + 原形動詞",
          "refrain from / abstain from + V-ing；can't afford 則固定接 to V"
        ]
      },
      {
        "title": "補充 2：used to 的關鍵是有沒有 be",
        "lines": [
          "used to + 原形動詞 ＝ 過去曾經（句中沒有 be 動詞）",
          "be used to + V-ing ＝ 習慣於（有 is / are / was / were）",
          "get used to + V-ing 強調逐漸適應，常搭 gradually、over time"
        ]
      },
      {
        "title": "補充 3：三個反直覺的點",
        "lines": [
          "regret to inform / regret to say 是商業書信固定用語，看到 regret 不要直覺選 V-ing",
          "stop 兩種都對，但 stop V-ing 在多益出現頻率遠高於 stop to V",
          "deserve + V-ing 帶被動語意：deserves addressing ＝ deserves to be addressed"
        ]
      }
    ]
  },
  "grammar/03_動狀詞_非謂語動詞/11_不定詞完成式與被動式": {
    "chapterId": "grammar/03_動狀詞_非謂語動詞/11_不定詞完成式與被動式",
    "title": "不定詞四種型態決策樹",
    "titleEn": "Decision Tree: Four Infinitive Forms",
    "decision": {
      "question": "先判主動被動，再判時間先後",
      "questionEn": "Voice First, Then Time",
      "branches": [
        {
          "label": "主動：邏輯主詞做動作",
          "labelEn": "Active: Subject Acts"
        },
        {
          "label": "被動：邏輯主詞被做",
          "labelEn": "Passive: Subject Is Acted Upon"
        }
      ]
    },
    "table": {
      "title": "不定詞型態總表",
      "titleEn": "Master Table of Infinitive Forms",
      "rowHeader": "時間關係",
      "rows": [
        {
          "head": "同時",
          "gloss": "與主要動詞同時",
          "cells": [
            [
              {
                "pattern": "seems",
                "token": "to V",
                "example": "seems to understand the terms"
              }
            ],
            [
              {
                "pattern": "needs",
                "token": "to be p.p.",
                "example": "needs to be reviewed"
              }
            ]
          ]
        },
        {
          "head": "更早",
          "gloss": "早於主要動詞",
          "cells": [
            [
              {
                "pattern": "claims",
                "token": "to have p.p.",
                "example": "claims to have paid the invoice"
              }
            ],
            [
              {
                "pattern": "is said",
                "token": "to have been p.p.",
                "example": "is said to have been approved"
              }
            ]
          ]
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：觸發完成式不定詞的動詞",
        "lines": [
          "claim / seem / appear / report + to have p.p.",
          "be said / be believed / be thought + to have p.p.",
          "共通點：用現在的立場陳述一件已經發生的事"
        ]
      },
      {
        "title": "補充 2：常考的兩組修飾語",
        "lines": [
          "glad / pleased / proud / sorry + to have p.p.（對已發生的事有感覺）",
          "動作與情緒同時發生時，用簡單式 to V",
          "the first / last / only + 名詞 + to have p.p.，常考句尾修飾語"
        ]
      },
      {
        "title": "補充 3：四種型態都在選項時",
        "lines": [
          "第一步找邏輯主詞是不是受詞角色 → 決定主動或被動",
          "第二步看動作是否早於主要動詞 → 決定簡單式或完成式",
          "兩步缺一不可；四個選項字尾一致（都是 p.p.）時考的就是這兩層"
        ]
      },
      {
        "title": "補充 4：慣用例外",
        "lines": [
          "ready / eager / anxious + to V 維持主動，即使語意帶被動",
          "ready to sign 指「合約準備好被簽」，仍不寫成 to be signed",
          "need / want / require 也可用主動 V-ing 表被動（needs revising）"
        ]
      }
    ]
  },
  "grammar/04_特殊動詞用法/02_感官動詞": {
    "chapterId": "grammar/04_特殊動詞用法/02_感官動詞",
    "title": "感官動詞用法決策樹",
    "titleEn": "Decision Tree: Perception Verb Usage",
    "decision": {
      "question": "受詞是做動作還是被做",
      "questionEn": "Does the Object Act or Get Acted Upon",
      "branches": [
        {
          "label": "主動：受詞執行動作",
          "labelEn": "Active: O Performs Action"
        },
        {
          "label": "被動：受詞接受動作",
          "labelEn": "Passive: Action Acts Upon O"
        }
      ]
    },
    "table": {
      "title": "感官動詞用法總表",
      "titleEn": "Master Table of Perception Verb Usage",
      "rowHeader": "動詞",
      "rows": [
        {
          "head": "see",
          "gloss": "看見",
          "cells": [
            [
              {
                "pattern": "see O",
                "token": "RV",
                "example": "saw him leave"
              },
              {
                "pattern": "see O",
                "token": "V-ing",
                "example": "saw him leaving"
              }
            ],
            [
              {
                "pattern": "see O",
                "token": "p.p.",
                "example": "saw the door closed"
              }
            ]
          ]
        },
        {
          "head": "hear",
          "gloss": "聽見",
          "cells": [
            [
              {
                "pattern": "hear O",
                "token": "RV",
                "example": "heard her speak"
              },
              {
                "pattern": "hear O",
                "token": "V-ing",
                "example": "heard her speaking"
              }
            ],
            [
              {
                "pattern": "hear O",
                "token": "p.p.",
                "example": "heard his name called"
              }
            ]
          ]
        },
        {
          "head": "watch",
          "gloss": "注視",
          "cells": [
            [
              {
                "pattern": "watch O",
                "token": "RV",
                "example": "watched them load"
              },
              {
                "pattern": "watch O",
                "token": "V-ing",
                "example": "watched them loading"
              }
            ],
            [
              {
                "pattern": "watch O",
                "token": "p.p.",
                "example": "watched the crate opened"
              }
            ]
          ]
        },
        {
          "head": "notice",
          "gloss": "注意到",
          "cells": [
            [
              {
                "pattern": "notice O",
                "token": "RV",
                "example": "noticed him hesitate"
              },
              {
                "pattern": "notice O",
                "token": "V-ing",
                "example": "noticed him hesitating"
              }
            ],
            [
              {
                "pattern": "notice O",
                "token": "p.p.",
                "example": "noticed the seal broken"
              }
            ]
          ]
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：RV 與 V-ing 差在哪",
        "lines": [
          "RV 表「看／聽到動作的全程」，動作已完成",
          "V-ing 表「看／聽到動作正在進行」，只看到片段",
          "watch 強調持續觀察，偏好搭 V-ing；look at 只是看一眼，較少接受詞補語"
        ]
      },
      {
        "title": "補充 2：被動化要補回 to",
        "lines": [
          "was seen to V、was heard to V、was made to V",
          "唯一不補 to 的情況：主動句補語本來就是 V-ing",
          "find / consider / believe 的被動接形容詞或 p.p.，不是 to V，別跟這組搞混"
        ]
      },
      {
        "title": "補充 3：兩個雙重身分",
        "lines": [
          "feel 也能當連綴動詞接形容詞（feel confident），看後面是動詞還是形容詞",
          "notice 也能直接接 that 子句（noticed that he left），此時要用完整子句",
          "沒有受詞、感官動詞直接接 that 子句時，不可用不定詞或分詞"
        ]
      },
      {
        "title": "補充 4：四選項時的刪除順序",
        "lines": [
          "先判受詞與動詞是不是被動關係 → 是就選 p.p.",
          "不是的話再判語意完成或進行 → 選 RV 或 V-ing",
          "先看語意再套公式，不要看到被動就無腦選 to V"
        ]
      }
    ]
  },
