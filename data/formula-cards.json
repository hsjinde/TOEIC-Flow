                "pattern": "turn",
                "token": "adv",
                "example": "turned sharply"
              }
            ]
          ]
        },
        {
          "head": "prove",
          "gloss": "證明是／證實",
          "cells": [
            [
              {
                "pattern": "prove",
                "token": "adj",
                "example": "proved effective"
              }
            ],
            [
              {
                "pattern": "prove O",
                "token": "adv",
                "example": "proved it conclusively"
              }
            ]
          ]
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：三組口訣",
        "lines": [
          "五感類：seem / appear / look / sound / feel",
          "變化類：become / turn / grow / go",
          "維持證明類：remain / stay / keep / prove"
        ]
      },
      {
        "title": "補充 2：-ly 結尾的形容詞陷阱",
        "lines": [
          "timely、costly、orderly、friendly、likely 都是形容詞",
          "看到 -ly 不要直覺當副詞刪掉，它們可以直接接在連綴動詞後面",
          "選項是「原形 / -ly / 形容詞 / 名詞」時，先確認動詞是不是連綴動詞"
        ]
      },
      {
        "title": "補充 3：兩個結構細節",
        "lines": [
          "連綴動詞 + 形容詞 + 介系詞片語是固定結構，片語只是修飾語，不會把答案變成副詞",
          "become 後面不能加 to be（become popular，不是 become to be popular）",
          "prove / turn out 可接形容詞或 to be + 形容詞，兩種都對"
        ]
      },
      {
        "title": "補充 4：remain / keep 的補語",
        "lines": [
          "remain unchanged、stay unaffected：p.p. 在此當形容詞，仍選形容詞形式",
          "keep 常接現在分詞（keep running）或形容詞（keep quiet），依語意判斷",
          "對比記憶：grow rapidly（副詞）vs. grow complicated（形容詞）"
        ]
      }
    ]
  },
  "grammar/04_特殊動詞用法/06_雙受詞動詞": {
    "chapterId": "grammar/04_特殊動詞用法/06_雙受詞動詞",
    "title": "雙受詞動詞改寫決策樹",
    "titleEn": "Decision Tree: Dative Alternation",
    "decision": {
      "question": "改寫時要配哪一個介系詞",
      "questionEn": "Which Preposition Does the Rewrite Take",
      "branches": [
        {
          "label": "雙受詞語序：V + 人 + 物",
          "labelEn": "Double Object: V + IO + DO"
        },
        {
          "label": "介系詞改寫：V + 物 + 介 + 人",
          "labelEn": "Rewrite: V + DO + Prep + IO"
        }
      ]
    },
    "table": {
      "title": "授予動詞介系詞總表",
      "titleEn": "Master Table of Dative Verbs",
      "rowHeader": "改寫用的介系詞",
      "rows": [
        {
          "head": "to",
          "gloss": "東西交到人手上",
          "cells": [
            [
              {
                "pattern": "send / give / show",
                "token": "IO + DO"
              }
            ],
            [
              {
                "pattern": "send DO",
                "token": "to IO"
              }
            ]
          ],
          "sharedExample": "sent the client an invoice = sent an invoice to the client"
        },
        {
          "head": "for",
          "gloss": "替某人做",
          "cells": [
            [
              {
                "pattern": "buy / make / find",
                "token": "IO + DO"
              }
            ],
            [
              {
                "pattern": "buy DO",
                "token": "for IO"
              }
            ]
          ],
          "sharedExample": "bought her a ticket = bought a ticket for her"
        },
        {
          "head": "of",
          "gloss": "ask 專用",
          "cells": [
            [
              {
                "pattern": "ask",
                "token": "IO + DO"
              }
            ],
            [
              {
                "pattern": "ask DO",
                "token": "of IO"
              }
            ]
          ],
          "sharedExample": "asked him a favor = asked a favor of him"
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：不可雙受詞黑名單",
        "lines": [
          "explain / describe / suggest / announce / introduce / mention / report / recommend / propose",
          "這些字一律「V + 物 + to + 人」，不能直接接人",
          "explain me the rule 是錯的，要寫 explain the rule to me"
        ]
      },
      {
        "title": "補充 2：沒有改寫形式的三個",
        "lines": [
          "cost / charge / owe 接雙受詞，但沒有對應的介系詞改寫",
          "看到選項在這三個字後面接 to / for 加物件，可直接刪去",
          "The delay cost us two weeks.（不能改寫成 cost two weeks to us）"
        ]
      },
      {
        "title": "補充 3：被動與代名詞語序",
        "lines": [
          "授予動詞的被動，人或物都能當主詞（was sent the invoice / was sent to the client）",
          "直接受詞是 it / them 時傾向改寫成「V + it + to 人」，gave me it 不自然",
          "explain 這類動詞被動時，人絕對不能當主詞"
        ]
      },
      {
        "title": "補充 4：商業情境高頻字",
        "lines": [
          "present / grant / issue / allocate / assign 常互相替換作誘答，看語境選「頒發」還是「分配」",
          "reimburse 接的物通常是費用類（expenses, costs, fees），接事件名詞要配 for",
          "guarantee / extend 在財務契約情境常接雙受詞表「保證給予」"
        ]
      }
    ]
  },
  "grammar/05_子句與假設語氣/04_假設語氣": {
    "chapterId": "grammar/05_子句與假設語氣/04_假設語氣",
    "title": "假設語氣時態決策樹",
    "titleEn": "Decision Tree: Unreal Conditionals",
    "decision": {
      "question": "與哪個時間的事實相反",
      "questionEn": "Which Time Is the Fact Contrary To",
      "branches": [
        {
          "label": "if 子句：往後退一格",
          "labelEn": "If-Clause: Back-Shifted"
        },
        {
          "label": "主句：would / could / might",
          "labelEn": "Main Clause: Modal"
        }
      ]
    },
    "table": {
      "title": "假設語氣時態總表",
      "titleEn": "Master Table of Unreal Conditionals",
      "rowHeader": "與何時的事實相反",
      "rows": [
        {
          "head": "現在",
          "gloss": "與現在事實相反",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "過去式"
              }
            ],
            [
              {
                "pattern": "S",
                "token": "would + RV"
              }
            ]
          ],
          "sharedExample": "If we had more time, we would revise the proposal."
        },
        {
          "head": "過去",
          "gloss": "與過去事實相反",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "had + p.p."
              }
            ],
            [
              {
                "pattern": "S",
                "token": "would have + p.p."
              }
            ]
          ],
          "sharedExample": "If they had ordered earlier, the parts would have arrived."
        },
        {
          "head": "混合",
          "gloss": "過去因、現在果",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "had + p.p."
              }
            ],
            [
              {
                "pattern": "S",
                "token": "would + RV"
              }
            ]
          ],
          "sharedExample": "If he had studied medicine, he would be a doctor now."
        },
        {
          "head": "未來",
          "gloss": "發生機率極低",
          "cells": [
            [
              {
                "pattern": "If S",
                "token": "were to V"
              }
            ],
            [
              {
                "pattern": "S",
                "token": "would + RV"
              }
            ]
          ],
          "sharedExample": "If the board were to reject it, we would revise the terms."
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：be 動詞一律用 were",
        "lines": [
          "不分人稱：If I were、If he were、If the result were",
          "多益考的是正式書面英文，was 在假設語氣裡不是安全解",
          "as if / as though 接假設語氣時同理（talks as if he were the manager）"
        ]
      },
      {
        "title": "補充 2：I wish 與 if only",
        "lines": [
          "時態同樣往後退一格：I wish I had more time（與現在相反）",
          "I wish I had known about the sale（與過去相反）",
          "if only 語氣比 I wish 更強，句型與 if 子句相同，通常單獨成句"
        ]
      },
      {
        "title": "補充 3：同家族的虛擬語氣",
        "lines": [
          "suggest / insist / demand / require / recommend 後的 that 子句用原形動詞",
          "不受主詞人稱與時態影響：It is essential that the report be accurate.",
          "否定是 not + 原形動詞，不可加 don't / doesn't"
        ]
      },
      {
        "title": "補充 4：怎麼跟真實條件句分開",
        "lines": [
          "先看主句助動詞：would / could / might → 假設；will / can / may → 真實",
          "再回頭檢查 if 子句時態有沒有跟著退一格",
          "現在式子句 + would 主句、過去式子句 + will 主句，都是常見誘答"
        ]
      }
    ]
  },
  "grammar/05_子句與假設語氣/06_關係代名詞省略非限定用法": {
    "chapterId": "grammar/05_子句與假設語氣/06_關係代名詞省略非限定用法",
    "title": "關係子句限定與非限定決策樹",
    "titleEn": "Decision Tree: Restrictive vs. Non-restrictive",
    "decision": {
      "question": "關代前面有沒有逗號",
      "questionEn": "Is There a Comma Before the Relative Pronoun",
      "branches": [
        {
          "label": "限定用法：沒有逗號",
          "labelEn": "Restrictive: No Comma"
        },
        {
          "label": "非限定用法：有逗號",
          "labelEn": "Non-restrictive: With Comma"
        }
      ]
    },
    "table": {
      "title": "關係代名詞總表",
      "titleEn": "Master Table of Relative Pronouns",
      "rowHeader": "關係代名詞",
      "rows": [
        {
          "head": "who",
          "gloss": "人、主格",
          "cells": [
            [
              {
                "pattern": "who",
                "token": "可換 that"
              }
            ],
            [
              {
                "pattern": ", who",
                "token": "不可換 that"
              }
            ]
          ],
          "sharedExample": "the engineer who fixed it / the engineer, who joined in May,"
        },
        {
          "head": "whom",
          "gloss": "人、受格",
          "cells": [
            [
              {
                "pattern": "whom",
                "token": "可省略"
              }
            ],
            [
              {
                "pattern": ", whom",
                "token": "不可省略"
              }
            ]
          ],
          "sharedExample": "the client (whom) we met / the client, whom we met last week,"
        },
        {
          "head": "which",
          "gloss": "物",
          "cells": [
            [
              {
                "pattern": "which",
                "token": "可換 that"
              }
            ],
            [
              {
                "pattern": ", which",
                "token": "不可換 that"
              }
            ]
          ],
          "sharedExample": "the report which arrived / the report, which arrived today,"
        },
        {
          "head": "whose",
          "gloss": "所有格",
          "cells": [
            [
              {
                "pattern": "whose + N",
                "token": "不可省略"
              }
            ],
            [
              {
                "pattern": ", whose + N",
                "token": "不可省略"
              }
            ]
          ],
          "sharedExample": "the vendor whose bid won the contract"
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：看到逗號先刪 that",
        "lines": [
          "that 完全不能用於非限定子句，選項有逗號就先刪含 that 的",
          "介系詞黏在關代前面時也只能用 which / whom（at which，不能 at that）",
          "of that、in that 當關代用在多益都是錯誤選項"
        ]
      },
      {
        "title": "補充 2：能不能省略，看空格後面",
        "lines": [
          "空格後主詞動詞都齊全 → 受格關代，可以省略",
          "空格後直接是動詞（沒有主詞）→ 主格，任何情況都不能省略",
          "介系詞在關代前面時同樣不能省略"
        ]
      },
      {
        "title": "補充 3：數量詞只配非限定",
        "lines": [
          "all / most / none / some + of which（物）／ of whom（人）",
          "前面一定有逗號，先行詞是前面提過的全體",
          "The company hired ten interns, most of whom graduated this year."
        ]
      },
      {
        "title": "補充 4：減化子句的條件",
        "lines": [
          "只有「關代 + be 動詞」的組合能省略成分詞：the employees (who are) working",
          "不是任何受格關代都能這樣減化",
          "雙逗號夾住一段時，動詞要配句子最外層的主詞，不是插入子句裡的名詞"
        ]
      }
    ]
  },
  "grammar/05_子句與假設語氣/10_假設語氣倒裝省略if": {
    "chapterId": "grammar/05_子句與假設語氣/10_假設語氣倒裝省略if",
    "title": "假設語氣倒裝決策樹",
    "titleEn": "Decision Tree: Inverted Conditionals",
    "decision": {
      "question": "主句長什麼樣子",
      "questionEn": "What Does the Main Clause Look Like",
      "branches": [
        {
          "label": "主句線索",
          "labelEn": "Clue in the Main Clause"
        },
        {
          "label": "句首要選的倒裝詞",
          "labelEn": "Word That Leads the Inversion"
        }
      ]
    },
    "table": {
      "title": "倒裝開頭字總表",
      "titleEn": "Master Table of Inversion Triggers",
      "rowHeader": "倒裝開頭字",
      "rows": [
        {
          "head": "Had",
          "gloss": "與過去相反",
          "cells": [
            [
              {
                "pattern": "S",
                "token": "would have + p.p."
              }
            ],
            [
              {
                "pattern": "Had S",
                "token": "p.p."
              }
            ]
          ],
          "sharedExample": "Had the team intervened, the incident would have been avoided."
        },
        {
          "head": "Were",
          "gloss": "與現在相反",
          "cells": [
            [
              {
                "pattern": "S",
                "token": "would + RV"
              }
            ],
            [
              {
                "pattern": "Were S",
                "token": "adj / to V"
              }
            ]
          ],
          "sharedExample": "Were the results inconclusive, the study would be extended."
        },
        {
          "head": "Should",
          "gloss": "萬一",
          "cells": [
            [
              {
                "pattern": "S",
                "token": "祈使句 / will"
              }
            ],
            [
              {
                "pattern": "Should S",
                "token": "RV"
              }
            ]
          ],
          "sharedExample": "Should you have any questions, please contact us."
        }
      ]
    },
    "notes": [
      {
        "title": "補充 1：倒裝與 if 不可並存",
        "lines": [
          "選項同時出現 if 又要求倒裝語序，一定是錯的",
          "Should 開頭的倒裝句不能換成 whether，兩者結構功能完全不同",
          "Were 用於所有人稱；Had / Should 不隨人稱變化"
        ]
      },
      {
        "title": "補充 2：否定放在主詞之後",
        "lines": [
          "Had + S + not + p.p.（Had the team not intervened, ...）",
          "不是 Had not the team intervened",
          "not 的位置在主詞之後、動詞之前"
        ]
      },
      {
        "title": "補充 3：三個同義的「要不是」",
        "lines": [
          "Had it not been for ＝ Without ＝ But for",
          "Had it not been for 是完整子句，後面可接完整句子",
          "Without / But for 只接名詞片語"
        ]
      },
      {
        "title": "補充 4：文體線索",
        "lines": [
          "合約條款、人資公告、財務備忘錄偏好用 Should / Had 倒裝取代 if",
          "Should 倒裝的後半句常以 please + V 或 be sure to + V 收尾",
          "倒裝句仍保有「與事實相反」或「機率低」的語氣，不同於 unless 的真實條件"
        ]
      }
    ]
  },
  "grammar/06_其他多益必考進階題型/01_比較級與最高級": {
    "chapterId": "grammar/06_其他多益必考進階題型/01_比較級與最高級",
    "title": "比較級與最高級決策樹",
    "titleEn": "Decision Tree: Comparative vs. Superlative",
    "decision": {
      "question": "比兩者還是三者以上",
      "questionEn": "Two Items or Three and More",
      "branches": [
        {
          "label": "比較級：兩者相比",
          "labelEn": "Comparative: Two Items"
